[Unit]
Description=Create the CindraOS live user and set its password
After=live-config.service
Before=display-manager.service

[Service]
Type=oneshot
ExecStart=/bin/sh -ec 'if ! id -u cindra >/dev/null 2>&1; then adduser --disabled-password --gecos "" --uid 1000 cindra; fi; usermod -aG sudo,audio,video cindra; echo "cindra:cindra1" | chpasswd'

[Install]
WantedBy=multi-user.target
